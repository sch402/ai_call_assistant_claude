# 这些变量都填在 Vercel 项目 › Settings › Environment Variables 里，不要提交到仓库。

# 部署后的网址，末尾不带 /，例如 https://ai-call-assistant.vercel.app
PUBLIC_BASE_URL=

# Twilio 控制台首页
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 你买的澳洲号码，E.164 格式，例如 +61212345678
TWILIO_PHONE_NUMBER=

# 你自己的手机号（被转移的那个号码），E.164 格式，例如 +61412345678
OWNER_PHONE_NUMBER=

# Vapi 控制台 › API Keys › Private Key
VAPI_API_KEY=
# 自己起一个不容易被猜到的名字，只用小写字母、数字和横线，例如 sch-callbot-7f3k9
VAPI_SIP_USERNAME=
# 自己生成的随机字符串（建议 32 位以上），用于验证 Vapi 回调
VAPI_WEBHOOK_SECRET=

# Supabase 项目 › Project Settings › API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 打开网页面板时要输入的口令，自己生成的随机字符串
DASHBOARD_TOKEN=

# 可选
# 对方问"你叫什么"时用的名字；开场白里不会主动说
ASSISTANT_NAME=Michael
# 音色：male-mature（成熟男声，默认）/ male-light / female-warm / female-light
ASSISTANT_VOICE=male-mature
# 开场白末尾是否加一句 "Calls to this number may be recorded."（默认不加；只有设为 true 才加）
RECORDING_NOTICE=false
MAX_CALL_SECONDS=300
