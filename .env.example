# 这些变量都填在 Vercel 项目 › Settings › Environment Variables 里，不要提交到仓库。

# 部署后的网址，末尾不带 /，例如 https://ai-call-assistant.vercel.app
PUBLIC_BASE_URL=

# Twilio 控制台首页
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# 你买的澳洲号码，E.164 格式，例如 +61212345678
TWILIO_PHONE_NUMBER=

# Vapi 控制台 › API Keys › Private Key
VAPI_API_KEY=
# 自己起一个不容易被猜到的名字，只用小写字母、数字和横线，例如 sch-callbot-7f3k9
VAPI_SIP_USERNAME=
# 自己生成的随机字符串（建议 32 位以上），用于验证 Vapi 回调
VAPI_WEBHOOK_SECRET=

# Supabase 项目 › Project Settings › API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 同一页面的 anon public key。iOS App 用它走手机号登录；它是公开的，所有表都开了行级安全，拿着它读不到数据。
SUPABASE_ANON_KEY=

# 打开网页面板时要输入的口令，自己生成的随机字符串
DASHBOARD_TOKEN=

# 苹果内购（App Store 自动续期订阅）
# App 的 Bundle ID，和 ios/project.yml 一致
APPLE_BUNDLE_ID=com.homeau.callassistant
# App Store Connect › App 信息 › 常规信息 › Apple ID（一串数字）。校验正式环境的交易时必须有。
APPLE_APP_APPLE_ID=6825135310
# 是否接受沙盒交易（TestFlight、App 审核、沙盒测试账号都是沙盒）。正式上架、审核通过后可改成 false。
APPLE_ALLOW_SANDBOX=true

# 陌生号码分析（来电详情里的「可能是 …」）。搜索服务和 ANTHROPIC_API_KEY 都配好才启用。
# 搜索服务二选一，优先 Serper（Google 结果，约 $0.30–1 / 千次，新账号送 2,500 次）：https://serper.dev
SERPER_API_KEY=
# 备选：Brave Search API（约 $5 / 千次，每月送 $5 额度）：https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# Anthropic API：https://console.anthropic.com
ANTHROPIC_API_KEY=
# 提取身份用的模型，默认最便宜的 claude-haiku-5-5
LOOKUP_MODEL=claude-haiku-5-5

# 可选
# 称呼、男声 / 女声、音色由每位用户在 App 里自己设置（存在 profiles 表），不再用环境变量。
MAX_CALL_SECONDS=300
# 公用号码上无法归属的来电（运营商没带转移来源、转移来源不是任何已登录用户、直接拨打这个号码）默认拒接。
# 设为 true 则照常接听（用默认声音、不带称呼，记录只在网页面板可见）。付费用户共用号码时必须保持 false，否则过期用户还能继续免费使用。
ACCEPT_UNATTRIBUTED_CALLS=false
